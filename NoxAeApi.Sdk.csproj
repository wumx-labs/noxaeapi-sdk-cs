<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>WumxLabs.NoxAeApi</PackageId>
    <Version>0.7.2</Version>
    <Authors>Wumx Labs;NoxAeApi Contributors</Authors>
    <Company>Wumx Labs</Company>
    <Description>Official C# / .NET SDK for NoxAeApi Minecraft REST API suite and Velocity Network Hub</Description>
    <RepositoryUrl>https://github.com/wumx-labs/noxaeapi-sdk-cs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/wumx-labs/noxaeapi-sdk-cs</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>WumxLabs.NoxAeApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

</Project>
